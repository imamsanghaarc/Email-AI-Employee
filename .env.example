# =============================================================================
# AI EMPLOYEE - Environment Configuration
# Copy this file to .env and fill in your credentials
# =============================================================================

# --- Bronze Tier ---
# VAULT_PATH=AI_Employee_Vault

# --- Silver Tier: LLM API Keys (at least one required for LLM planning) ---
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# GEMINI_API_KEY=your_gemini_api_key
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# OPENAI_API_KEY=sk-your_key_here

# --- Silver Tier: Model Selection (optional) ---
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# OPENAI_MODEL=gpt-4o

# --- Gold Tier: Email ---
# EMAIL_ADDRESS=your@gmail.com
# EMAIL_APP_PASSWORD=your_16_char_app_password

# --- Gold Tier: Gmail Watcher (IMAP) ---
# GMAIL_ADDRESS=your@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password

# --- Gold Tier: LinkedIn ---
# LINKEDIN_EMAIL=your@linkedin.com
# LINKEDIN_PASSWORD=your_password

# --- Gold Tier: Facebook ---
# FB_EMAIL=your@facebook.com
# FB_PASSWORD=your_password

# --- Gold Tier: Twitter/X ---
# TWITTER_USER=your_twitter_handle
# TWITTER_PASSWORD=your_password

# --- Gold Tier: Instagram ---
# INSTA_USER=your_insta_handle
# INSTA_PASSWORD=your_password

# --- Gold Tier: Odoo ERP ---
# ODOO_URL=http://localhost:8069
# ODOO_DB=odoo
# ODOO_USER=admin
# ODOO_PASSWORD=admin

# --- Gold Tier: Business Context ---
# COMPANY_NAME=Your Company Name
# BUSINESS_DESCRIPTION=What your business does
# TARGET_AUDIENCE=Small business owners
# KEY_SERVICES=Web development, SEO
# CALL_TO_ACTION=Book a free consultation

# --- Gold Tier: MCP Server ---
# MCP_HOST=0.0.0.0
# MCP_PORT=8765

# --- System Settings ---
# LOG_LEVEL=INFO
# SCHEDULER_INTERVAL=300
